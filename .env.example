# =========================================================
# AI Dental Automation
# Single shared environment file for the full monorepo
# Copy to `.env` and fill real values before running services
# =========================================================
#
# Structure:
# - SHARED: cross-app values
# - WEB: used by apps/web (Vite)
# - API: used by apps/api (NestJS)
# - APP DATABASE: current app runtime DB config
# - SHARED DOCKER STACK: your machine-level Docker ports/credentials

# =========================================================
# SHARED KEYS
# Used by: web, api
# =========================================================
NODE_ENV=development
APP_NAME=ai-dental-automation
APP_VERSION=1.0.0

# Shared URLs / Ports
WEB_URL=http://localhost:3020
ADMIN_URL=http://localhost:3021
API_URL=http://localhost:3022
WEB_PORT=3020
ADMIN_PORT=3021
PORT=3022

# =========================================================
# WEB KEYS
# Used by: apps/web
# =========================================================
VITE_APP_NAME=Lumière Dental
VITE_WEB_URL=http://localhost:3020
VITE_WEB_PORT=3020
VITE_API_URL=http://localhost:3022
VITE_WHATSAPP_NUMBER=+15551234567

# =========================================================
# API KEYS
# Used by: apps/api
# =========================================================
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3020,http://localhost:3021

# Auth
JWT_SECRET=replace-with-a-strong-secret
REFRESH_TOKEN_SECRET=replace-with-a-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_CLINIC_SLUG=lumiere-dental

# Encryption / Response Security
ENABLE_ENCRYPTION=false
ENCRYPTION_SECRET_KEY=replace-with-32-char-secret-key

# =========================================================
# APP DATABASE KEYS
# Used by: apps/api, packages/db
# Single DB for both admin and user flows
# Current backend is using MySQL
# =========================================================
DB_PROVIDER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=testdb_automation
DB_USER=root
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=admin123

DATABASE_URL=mysql://root:admin123@127.0.0.1:3306/testdb_automation
DIRECT_URL=mysql://root:admin123@127.0.0.1:3306/testdb_automation

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_PREFIX=ai-dental-automation

# WhatsApp Provider
WHATSAPP_PROVIDER=mock
WHATSAPP_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01

# n8n Webhooks
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_SECRET=my-super-secret-123
N8N_LEAD_FOLLOWUP_WEBHOOK=/webhook/lead-followup
N8N_BOOKING_CONFIRMATION_WEBHOOK=/webhook/booking-confirmation
N8N_REVIEW_REQUEST_WEBHOOK=/webhook/review-request
N8N_WEBHOOK_TIMEOUT_MS=5000

# =========================================================
# SHARED DOCKER STACK KEYS
# These defaults assume your common Docker stack is already running
# =========================================================

# MySQL / phpMyAdmin
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=testdb_automation
MYSQL_ROOT_PASSWORD=admin123
PHPMYADMIN_PORT=8084
PHPMYADMIN_UPLOAD_LIMIT=128M
